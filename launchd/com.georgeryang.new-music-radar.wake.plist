<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.georgeryang.new-music-radar.wake</string>
  <!-- Root runs this, so it must point at the root-owned copy README installs,
       never the user-writable repo file. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Library/Application Support/new-music-radar/schedule-wake.sh</string>
  </array>
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/var/log/new-music-radar-wake.log</string>
  <key>StandardErrorPath</key>
  <string>/var/log/new-music-radar-wake.log</string>
</dict>
</plist>
