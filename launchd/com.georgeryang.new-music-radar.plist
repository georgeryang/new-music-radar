<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.georgeryang.new-music-radar</string>
  <!-- caffeinate holds a sleep assertion only while update.sh runs: ~1s on
       fresh ticks, 5-20 min on the one daily fetch. -s prevents system sleep
       but is AC-only; -i prevents idle sleep; -m covers disk. On battery none
       of these hold a lid-closed Mac: the 05:30 wake is a dark wake with a
       30-45s budget that ends in 'Maintenance Sleep', which -i does not gate,
       so the run finishes in fragments across later wakes. The absolute paths
       below are for this machine only; README's install command rewrites them
       for whatever machine it runs on. -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string>
    <string>-sim</string>
    <string>/bin/bash</string>
    <string>/Users/georgeyang/dev/new-music-radar/scripts/update.sh</string>
    <string>--if-stale</string>
  </array>
  <!-- 10-minute tick. launchd fires a missed tick once when the Mac wakes
       from sleep, so this doubles as the wake-up trigger. The --if-stale
       guard in update.sh turns ticks into exactly one fetch per day, in the
       18:15-18:30 KST window when awake or at first wake after it. A fixed
       StartCalendarInterval can't do this: it uses the Mac's local timezone,
       which drifts against KST with DST and travel. -->
  <key>StartInterval</key>
  <integer>600</integer>
  <!-- Not the staleness anchor, only a wake-catch trigger. 05:25 is strictly
       before the 05:30 pmset wake, so the fire is already missed and launchd
       runs it the moment the Mac wakes. It exists because the coalesced
       StartInterval tick was instead deferred past the short wake. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Hour</key><integer>5</integer>
      <key>Minute</key><integer>25</integer>
    </dict>
  </array>
  <key>StandardOutPath</key>
  <string>/Users/georgeyang/Library/Logs/new-music-radar.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/georgeyang/Library/Logs/new-music-radar.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <!-- Runs at every login/boot; the --if-stale guard makes it a no-op unless
       the data is stale (e.g. the Mac was powered off past a tick). -->
  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>
