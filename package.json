{
  "name": "new-music-radar",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && node scripts/build-site.mjs",
    "preview": "vite preview",
    "fetch": "node scripts/fetch-releases.mjs",
    "check-genres": "node scripts/check-genre-coverage.mjs",
    "audit-sources": "node scripts/audit-sources.mjs",
    "update": "bash scripts/update.sh",
    "setup-skills": "bash scripts/setup-skills.sh",
    "check-editor": "node scripts/check-editor.mjs",
    "check-types": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs tests/*.test.ts",
    "test:browser": "node --test tests/editor.spec.mjs",
    "test:browser:install": "playwright install chromium"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "playwright": "1.61.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  }
}
